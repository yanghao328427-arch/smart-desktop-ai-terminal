<view class="page">
  <view class="nav-bar">
    <button wx:if="{{currentView != 'home'}}" class="nav-back" data-view="home" bindtap="setView">‹</button>
    <text>{{currentTitle}}</text>
    <button class="nav-refresh" bindtap="manualRefresh">刷新</button>
  </view>

  <block wx:if="{{currentView == 'home'}}">
    <view class="hero">
      <view class="hero-top">
        <view>
          <text class="eyebrow">Smart Desktop</text>
          <text class="title">智能桌面 AI 终端</text>
        </view>
        <view class="live-pill {{summary.readyClass}}">
          <text>{{summary.readyScore}}</text>
        </view>
      </view>

      <view class="status-overview">
        <text class="status-label">实时链路</text>
        <text class="status-value">{{summary.onlineText}}</text>
        <text class="status-time">最近上报 {{summary.lastSeenText}}</text>
      </view>

      <view class="status-list">
        <block wx:for="{{statusItems}}" wx:key="label">
          <view class="status-row">
            <view class="status-dot {{item.tone}}"></view>
            <view class="status-main">
              <text class="status-name">{{item.label}}</text>
              <text class="status-note">{{item.note}}</text>
            </view>
            <text class="status-state">{{item.value}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="section-title">功能</view>
    <view class="menu-list">
      <button class="menu-item" data-view="overview" bindtap="setView">
        <view><text>链路总览</text><text>云端、设备、UART、ACK</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="security" bindtap="setView">
        <view><text>安全设置</text><text>控制口令 {{tokenSavedText}}</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="control" bindtap="setView">
        <view><text>硬件控制</text><text>风扇、蜂鸣、锁定、解锁</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="sensors" bindtap="setView">
        <view><text>传感器</text><text>温湿度、距离、旋钮、RGB</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="chat" bindtap="setView">
        <view><text>AI 对话</text><text>{{summary.aiText}}</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="rfid" bindtap="setView">
        <view><text>RFID</text><text>{{summary.lastRfidText}}</text></view><text>›</text>
      </button>
      <button class="menu-item" data-view="actions" bindtap="setView">
        <view><text>动作记录</text><text>ACK {{summary.ackText}}</text></view><text>›</text>
      </button>
    </view>
  </block>

  <block wx:elif="{{currentView == 'overview'}}">
    <view class="panel">
      <view class="panel-title"><text>链路状态</text><text>{{refreshTime}}</text></view>
      <view class="status-list inset">
        <block wx:for="{{statusItems}}" wx:key="label">
          <view class="status-row">
            <view class="status-dot {{item.tone}}"></view>
            <view class="status-main">
              <text class="status-name">{{item.label}}</text>
              <text class="status-note">{{item.note}}</text>
            </view>
            <text class="status-state">{{item.value}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="panel">
      <view class="panel-title"><text>后端</text><text>{{socketText}}</text></view>
      <view class="form-stack">
        <input value="{{apiBase}}" placeholder="https://8-163-38-158.sslip.io" bindinput="onApiBaseInput" />
        <button bindtap="saveApiBase">保存后端地址</button>
      </view>
      <text class="helper">设备 {{deviceId}} · 协议 {{summary.protocolText}}</text>
    </view>
  </block>

  <block wx:elif="{{currentView == 'security'}}">
    <view class="panel security-panel">
      <view class="panel-title"><text>控制保护</text><text>{{tokenSavedText}}</text></view>
      <view class="security-card {{tokenSaved ? 'ok' : 'warn'}}">
        <text>{{tokenSaved ? '本次打开期间可用' : '未输入控制口令，只能刷已注册卡进入上下文'}}</text>
        <text>状态读取公开；控制、对话、RFID、ASR 写入必须携带口令。</text>
      </view>
      <view class="form-stack">
        <input password="true" value="{{controlTokenDraft}}" placeholder="输入 CONTROL_TOKEN" bindinput="onControlTokenInput" />
        <button bindtap="saveControlToken">本次启用</button>
        <button class="secondary danger" bindtap="clearControlToken">清除本次口令</button>
        <button class="secondary" data-view="diagnostics" bindtap="setView">打开后台日志</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentView == 'control'}}">
    <view class="panel">
      <view class="panel-title"><text>硬件控制</text><text>{{tokenSavedText}}</text></view>
      <view class="control-list">
        <button class="control-row on" data-tool="fan_on" bindtap="sendHardwareAction">
          <view><text>风扇开启</text><text>下发 DRV8833 风扇动作</text></view><text>›</text>
        </button>
        <button class="control-row" data-tool="beep" bindtap="sendHardwareAction">
          <view><text>蜂鸣提醒</text><text>触发本地提示音</text></view><text>›</text>
        </button>
        <button class="control-row lock" data-tool="lock" bindtap="sendHardwareAction">
          <view><text>锁定</text><text>进入安全锁定状态</text></view><text>›</text>
        </button>
        <button class="control-row unlock" data-tool="unlock" bindtap="sendHardwareAction">
          <view><text>解锁</text><text>恢复授权运行</text></view><text>›</text>
        </button>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentView == 'sensors'}}">
    <view class="panel">
      <view class="panel-title"><text>传感器</text><text>实时摘要</text></view>
      <view class="metric-grid">
        <view class="metric"><text>温度</text><text>{{summary.temperatureText}}</text></view>
        <view class="metric"><text>湿度</text><text>{{summary.humidityText}}</text></view>
        <view class="metric"><text>距离</text><text>{{summary.distanceText}}</text></view>
        <view class="metric"><text>电位器</text><text>{{summary.potText}}</text></view>
        <view class="metric"><text>NTC</text><text>{{summary.ntcText}}</text></view>
        <view class="metric"><text>RGB</text><text>{{summary.rgbStatusText}}</text></view>
      </view>
      <view class="status-list inset">
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">交互距离</text><text class="status-note">{{summary.interactionText}}</text></view><text class="status-state">{{summary.distanceZoneText}}</text></view>
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">环境状态</text><text class="status-note">AHT20 / NTC 综合判断</text></view><text class="status-state">{{summary.envStateText}}</text></view>
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">编码器</text><text class="status-note">旋钮与按键</text></view><text class="status-state">{{summary.encoderText}}</text></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentView == 'chat'}}">
    <view class="panel">
      <view class="panel-title"><text>AI 对话</text><text>{{summary.aiText}}</text></view>
      <view class="quick-grid">
        <button class="secondary" data-text="你是谁" bindtap="sendPreset">自我介绍</button>
        <button class="secondary" data-text="现在状态怎么样？结合温湿度和距离告诉我，并给我一个学习建议。" bindtap="sendPreset">状态建议</button>
        <button class="secondary" data-text="打开风扇并进入专注30分钟" bindtap="sendPreset">组合动作</button>
      </view>
      <view class="chat">
        <block wx:if="{{messages.length}}">
          <block wx:for="{{messages}}" wx:key="id">
            <view class="bubble {{item.role}}">{{item.text}}</view>
          </block>
        </block>
        <text wx:else class="empty">还没有对话，先发一条真实指令。</text>
      </view>
      <view class="row">
        <input value="{{chatText}}" placeholder="输入指令或问题..." bindinput="onChatInput" />
        <button bindtap="sendChat">发送</button>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentView == 'rfid'}}">
    <view class="panel">
      <view class="panel-title"><text>RFID</text><text>{{summary.lastRfidText}}</text></view>
      <view class="form-stack">
        <input value="{{rfid.userId}}" placeholder="已有 user_id（可选）" bindinput="onRfidUserIdInput" />
        <input value="{{rfid.name}}" placeholder="用户名（新用户必填）" bindinput="onRfidNameInput" />
        <input value="{{rfid.profileSummary}}" placeholder="上下文摘要（可选）" bindinput="onRfidSummaryInput" />
        <input value="{{rfid.adminNotes}}" placeholder="管理备注（可选）" bindinput="onRfidNotesInput" />
        <picker mode="selector" range="{{modes}}" value="{{modeIndex}}" bindchange="onModeChange">
          <view class="picker">模式：{{modes[modeIndex]}}</view>
        </picker>
        <input value="{{rfid.uid}}" placeholder="手动 UID 备选，例如 04A1B2C3" bindinput="onRfidUidInput" />
        <view class="row two">
          <button bindtap="startRfidEnrollment">在线注册</button>
          <button bindtap="registerRfid">手动绑定</button>
          <button class="secondary" bindtap="scanRfid">模拟刷卡</button>
        </view>
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">注册状态</text><text class="status-note">{{rfid.enrollId}}</text></view><text class="status-state">{{rfid.enrollStatus}}</text></view>
      </view>
      <view class="status-list inset">
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">最近 RFID</text><text class="status-note">{{summary.lastRfidAtText}}</text></view><text class="status-state">{{summary.lastRfidText}}</text></view>
        <view class="status-row"><view class="status-dot"></view><view class="status-main"><text class="status-name">最近 ASR</text><text class="status-note">{{summary.lastAsrAtText}}</text></view><text class="status-state">{{summary.lastAsrStatusText}}</text></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{currentView == 'actions'}}">
    <view class="panel">
      <view class="panel-title"><text>最近动作</text><text>{{summary.lastSeenText}}</text></view>
      <block wx:if="{{recentActions.length}}">
        <block wx:for="{{recentActions}}" wx:key="id">
          <view class="action-item">
            <text class="action-title">{{item.title}}</text>
            <text class="action-line">{{item.line}}</text>
            <text class="action-time">{{item.time}}</text>
          </view>
        </block>
      </block>
      <text wx:else class="helper">暂无动作记录</text>
    </view>
  </block>

  <block wx:elif="{{currentView == 'diagnostics'}}">
    <view class="panel diagnostics">
      <view class="panel-title"><text>后台日志</text><text>JSON</text></view>
      <text class="mono">{{diagnosticsText}}</text>
    </view>
  </block>
</view>
