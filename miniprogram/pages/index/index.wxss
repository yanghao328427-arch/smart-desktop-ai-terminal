.page {
  background: #050b12;
  color: #f8fbff;
  min-height: 100vh;
  padding: 22rpx;
}

.hero,
.panel {
  background: linear-gradient(180deg, rgba(18, 29, 42, 0.96), rgba(8, 17, 28, 0.98));
  border: 1rpx solid rgba(102, 178, 255, 0.16);
  border-radius: 28rpx;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.28);
  margin-bottom: 22rpx;
  overflow: hidden;
}

.hero {
  padding: 26rpx;
}

.hero-top,
.panel-title {
  align-items: center;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.eyebrow,
.panel-meta,
.helper,
.empty {
  color: #8ea3b8;
  font-size: 22rpx;
}

.title {
  color: #ffffff;
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0;
  margin-top: 8rpx;
}

.ghost,
button.secondary {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  color: #d6e4f2;
}

.score-card {
  align-items: center;
  background:
    radial-gradient(circle at 50% 18%, rgba(30, 224, 141, 0.18), transparent 42%),
    rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(45, 212, 191, 0.24);
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 260rpx;
  margin-top: 26rpx;
  padding: 28rpx;
}

.score-label {
  color: #90a4ba;
  font-size: 24rpx;
}

.score-value {
  color: #ffffff;
  font-size: 82rpx;
  font-weight: 900;
  letter-spacing: 0;
  line-height: 1.05;
  margin-top: 8rpx;
}

.score-sub {
  color: #32d583;
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.score-card.warn .score-sub {
  color: #fdb022;
}

.score-card.bad .score-sub,
.score-card.wait .score-sub {
  color: #f97066;
}

.status-strip {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 22rpx;
}

.status-chip {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 18rpx;
  padding: 16rpx;
}

.status-chip text,
.panel-title text,
.sensor-row text,
.kv text {
  display: block;
}

.status-chip text:first-child {
  color: #8ea3b8;
  font-size: 21rpx;
}

.status-chip text:last-child {
  color: #f8fbff;
  font-size: 24rpx;
  font-weight: 700;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.panel {
  padding: 24rpx;
}

.panel-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.row {
  align-items: center;
  display: grid;
  gap: 14rpx;
  grid-template-columns: 1fr auto;
}

.row.two {
  grid-template-columns: repeat(2, 1fr);
}

input,
.picker {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 18rpx;
  color: #ffffff;
  min-height: 80rpx;
  padding: 0 20rpx;
}

button {
  background: linear-gradient(135deg, #14b8ff, #1677ff);
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  font-weight: 750;
  min-height: 80rpx;
}

.helper {
  display: block;
  margin-top: 14rpx;
}

.control-grid {
  display: grid;
  gap: 16rpx;
  grid-template-columns: repeat(2, 1fr);
}

.control {
  align-items: flex-start;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 148rpx;
  padding: 20rpx;
  text-align: left;
}

.control.on {
  background: linear-gradient(135deg, rgba(18, 183, 106, 0.42), rgba(18, 183, 106, 0.12));
  border-color: rgba(50, 213, 131, 0.40);
}

.control.lock {
  background: linear-gradient(135deg, rgba(247, 144, 9, 0.42), rgba(247, 144, 9, 0.12));
  border-color: rgba(253, 176, 34, 0.42);
}

.control.unlock {
  background: linear-gradient(135deg, rgba(18, 103, 241, 0.42), rgba(18, 103, 241, 0.12));
  border-color: rgba(83, 177, 253, 0.36);
}

.control-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 850;
}

.control-sub {
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.sensor-list,
.kv-list {
  display: grid;
  gap: 2rpx;
}

.sensor-row,
.kv {
  align-items: center;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.12);
  display: grid;
  gap: 18rpx;
  grid-template-columns: 160rpx 1fr;
  min-height: 70rpx;
}

.sensor-row:last-child,
.kv:last-child {
  border-bottom: 0;
}

.sensor-row text:first-child,
.kv text:first-child {
  color: #91a5ba;
  font-size: 24rpx;
}

.sensor-row text:last-child,
.kv text:last-child {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 750;
  overflow-wrap: anywhere;
  text-align: right;
}

.quick-grid {
  display: grid;
  gap: 12rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 18rpx;
}

.chat {
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 22rpx;
  margin-bottom: 16rpx;
  max-height: 420rpx;
  min-height: 220rpx;
  overflow: auto;
  padding: 18rpx;
}

.bubble {
  border-radius: 18rpx;
  display: block;
  margin-bottom: 14rpx;
  max-width: 86%;
  overflow-wrap: anywhere;
  padding: 16rpx 18rpx;
  white-space: pre-wrap;
}

.bubble.user {
  background: linear-gradient(135deg, #1677ff, #14b8ff);
  color: #ffffff;
  margin-left: 60rpx;
}

.bubble.assistant {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  color: #d9e7f7;
  margin-right: 60rpx;
}

.empty {
  display: block;
  padding: 50rpx 0;
  text-align: center;
}

.form-stack {
  display: grid;
  gap: 14rpx;
}

.action-item {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  padding: 18rpx;
}

.action-title,
.action-line,
.action-time {
  display: block;
}

.action-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 750;
}

.action-line {
  color: #adc1d7;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 21rpx;
  margin-top: 10rpx;
  word-break: break-all;
}

.action-time {
  color: #7f92a7;
  font-size: 21rpx;
  margin-top: 8rpx;
}

.mono {
  color: #b7c7d8;
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 21rpx;
  max-height: 360rpx;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
}

.diagnostics {
  margin-bottom: 40rpx;
}
