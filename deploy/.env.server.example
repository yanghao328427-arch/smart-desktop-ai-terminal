# Copy this file to deploy/.env.server on the cloud server.
# Do not commit the real deploy/.env.server file.

# Use ":80" for a quick IP-only HTTP test.
# Use a real domain such as "smartdesk.example.com" for HTTPS/WSS.
SMARTDESK_SITE_ADDRESS=smartdesk.example.com

APP_NAME=Smart Desktop AI Terminal
DEVICE_ID=desktop-agent-001
EDGE_ID=esp32s3-sense-001

AI_PROVIDER=dashscope_openai
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key

ASR_PROVIDER=dashscope_paraformer
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_MODEL=paraformer-realtime-v2
ASR_LANGUAGE_HINT=zh

CONTROL_TOKEN=replace_with_a_private_control_token
